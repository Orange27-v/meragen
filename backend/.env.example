# Firebase web config — Console -> Project settings -> General -> "Your apps".
# These four are public by design; they identify the project, they do not grant
# access. The private key belongs only in the API's .env, never here.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Where the API lives.
API_URL="http://localhost:3001"
